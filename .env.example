# Copy to .env (git-ignored) to configure your build. Every value is optional.

# Your TabLens API — the Cloudflare Worker in server/ that holds your Gemini key.
# Leave empty for a build without cloud AI (Gemini Nano on device + heuristics still work).
TABLENS_API=

# Public key that pins your extension id for unpacked builds, so your API's allow-list
# (ALLOWED_EXTENSION_IDS) can name it. Generate with `pnpm keygen`.
TABLENS_MANIFEST_KEY=
