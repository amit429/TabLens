{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tablens-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // The shared contract (../src/lib/ai/contract.ts) imports zod; resolve it from this package so the
  // Worker builds when only server/ is installed (e.g. Cloudflare Workers Builds with root "server").
  "alias": { "zod": "./node_modules/zod" },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Anonymous per-install daily counters. No content is ever written here.
  // Wrangler provisions the namespace on first deploy; on older versions run
  // `wrangler kv namespace create QUOTA` and paste its id here.
  "kv_namespaces": [{ "binding": "QUOTA" }],
  // Burst protection per install and per IP.
  "ratelimits": [
    { "name": "INSTALL_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "IP_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "DAILY_NAMING_LIMIT": "60",
    "DAILY_SUMMARY_LIMIT": "200",
    "DAILY_IP_LIMIT": "300",
    // Hard ceiling on Gemini calls per day across everyone. Raise it as usage grows.
    "DAILY_GLOBAL_LIMIT": "3000"
  }
  // Secrets — set in the Cloudflare dashboard (Settings → Variables and Secrets → type Secret)
  // or with `wrangler secret put`; never in this file:
  //   GEMINI_API_KEY         your Gemini key
  //   ALLOWED_EXTENSION_IDS  your extension id(s), comma-separated. Unset = refuse all requests.
}
