    "@google/genai": "^3.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "typescript": "5.9.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  }
}
